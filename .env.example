# Copy to .env for local development (uv run ...). Docker Compose sets its own values.
DATABASE_URL=postgresql+psycopg://codementor:codementor@localhost:5432/codementor

# Used by docker-compose.yml; change it for anything that isn't a throwaway machine.
POSTGRES_PASSWORD=codementor

