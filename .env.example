# Copy to .env for local development (uv run ...). Docker Compose sets its own values.
DATABASE_URL=postgresql+psycopg://codementor:codementor@localhost:5432/codementor

# Used by docker-compose.yml; change it for anything that isn't a throwaway machine.
POSTGRES_PASSWORD=codementor

# Codeforces OpenID Connect (register an OAuth application with Codeforces).
# Sign-in is disabled while any of these values is empty.
# CODEFORCES_OIDC_CLIENT_ID=
# CODEFORCES_OIDC_CLIENT_SECRET=
# CODEFORCES_OIDC_STATE_SECRET=
# Match the host the browser uses: :4200 for `ng serve`, :8080 for Docker Compose,
# or :8000 when using the API without the Angular dev server.
# CODEFORCES_OIDC_REDIRECT_URI=http://localhost:4200/api/auth/callback

# AI coach: any OpenAI-compatible chat-completions provider. Leave the key or model
# empty to keep the coach disabled (the rest of the app still works).
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
